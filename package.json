{
  "name": "hass-home-glass-dashboard",
  "version": "2.0.1",
  "description": "iOS 26 Liquid Glass style dashboard strategy for Home Assistant",
  "main": "custom_components/home_glass/frontend/home-glass-dashboard.js",
  "scripts": {
    "build": "webpack",
    "build:dev": "webpack --mode=development --watch",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,css,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "keywords": [
    "home-assistant",
    "apple-home",
    "dashboard",
    "strategy",
    "smart-home"
  ],
  "author": "Apple Home Dashboard Team",
  "contributors": [
    {
      "name": "NitayBZ",
      "url": "https://github.com/nitaybz"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nitaybz"
  },
  "license": "MIT",
  "dependencies": {
    "@types/sortablejs": "^1.15.9",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "version-bump-prompt": "^6.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nitaybz/apple-home-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/nitaybz/apple-home-dashboard/issues"
  },
  "homepage": "https://github.com/nitaybz/apple-home-dashboard#readme",
  "files": [
    "dist/",
    "src/",
    "hacs.json",
    "webpack.config.ts",
    "package.json",
    "README.md"
  ],
  "hacs": {
    "name": "Apple Home Dashboard Strategy",
    "filename": "apple-home-dashboard.js",
    "render_readme": true
  }
}
